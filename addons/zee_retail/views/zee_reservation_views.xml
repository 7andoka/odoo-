<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_zee_reservation_settle" model="ir.ui.view">
        <field name="name">sale.order.form.zee.reservation.settle</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(zee_retail.zee_reservation_settle_action)d" type="action"
                    string="Settle Reservation" class="btn-primary"
                    invisible="not zee_is_reservation or state != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>
