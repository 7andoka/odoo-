<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.zee_retail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_zee_issue_return_voucher"
                        string="Issue Return Voucher"
                        type="object"
                        groups="sales_team.group_sale_manager,point_of_sale.group_pos_manager"
                        invisible="move_type != 'out_refund' or state != 'posted' or zee_return_voucher_id"/>
            </header>
            <field name="partner_id" position="after">
                <field name="zee_return_voucher_id" invisible="not zee_return_voucher_id"/>
            </field>
        </field>
    </record>
</odoo>
