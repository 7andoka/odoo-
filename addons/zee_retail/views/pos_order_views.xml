<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.zee_retail</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <button name="refund" position="after">
                <button name="action_zee_issue_return_voucher"
                        string="Issue Return Voucher"
                        type="object"
                        groups="sales_team.group_sale_manager,point_of_sale.group_pos_manager"
                        invisible="state not in ('paid', 'done') or amount_total >= 0 or zee_return_voucher_id"/>
            </button>
            <field name="partner_id" position="after">
                <field name="zee_return_voucher_id" invisible="not zee_return_voucher_id"/>
            </field>
        </field>
    </record>
</odoo>
