<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Goods sent from a branch and not yet received by the other one wait here -->
    <record id="stock_location_zee_transit" model="stock.location">
        <field name="name">Branch Transit</field>
        <field name="usage">transit</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_sequence_branch_transfer" model="ir.sequence">
        <field name="name">Zee Branch Transfer</field>
        <field name="code">zee.branch.transfer</field>
        <field name="prefix">TRF/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_sequence_stock_audit" model="ir.sequence">
        <field name="name">Zee Stock Audit</field>
        <field name="code">zee.stock.audit</field>
        <field name="prefix">AUD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_sequence_daily_closing" model="ir.sequence">
        <field name="name">Zee Daily Closing</field>
        <field name="code">zee.daily.closing</field>
        <field name="prefix">Z/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_sequence_employee_advance" model="ir.sequence">
        <field name="name">Zee Employee Advance</field>
        <field name="code">zee.employee.advance</field>
        <field name="prefix">ADV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
