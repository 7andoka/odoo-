<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 12 digits (622 + 9 digit counter); the check digit makes it an EAN-13 barcode -->
    <record id="ir_sequence_product_barcode" model="ir.sequence">
        <field name="name">Zee Product Barcode</field>
        <field name="code">zee.product.barcode</field>
        <field name="prefix">622</field>
        <field name="padding">9</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
